# Whitelist: ignore everything, then re-allow only the public dashboard files.
# Everything else in this folder (task SKILL.md files, sync machinery, logs)
# stays local-only and can never be committed to this public repo.
/*
!/.gitignore
!/claude.html
# theme.css: the shared palette, copied from the private theme pack. A named
# public file, the same pattern tests.html and make_favicon.py follow — NOT a
# loosening of the /* rule above. claude.html links it, so it must ship.
!/theme.css
!/tests.html
!/README.md
!/LICENSE
!/favicon.ico
!/make_favicon.py
!/data/
/data/*
!/data/data-*.js
